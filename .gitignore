# Generated build artifacts (recreated by `charly box generate` / `charly box build`)
.build/
# Generated context-ignore files (podman reads .containerignore, docker .dockerignore)
.containerignore
.dockerignore
# Eval run scratch
.check/
# VM / disk-image build outputs (`charly vm build` writes image/<vm>/ — the `output/`
# entry this replaces named a directory nothing has ever written; measured 2026-11-13,
# the first run of the check-substrate bed here left image/eval-vm/ untracked)
image/
# Editor scratch
*.swp
*~

# Migration rollback backups (charly migrate writes <file>.bak.<unix-ts>)
*.bak
*.bak.*
